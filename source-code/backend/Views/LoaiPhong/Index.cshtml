@model List<LoaiPhong>
@{ ViewData["Title"] = "Loại phòng"; var laAdmin = User.IsInRole("Administrator"); }
<div class="d-flex justify-content-between align-items-center mb-3 page-heading"><div><div class="eyebrow">CẤU HÌNH CHO THUÊ</div><h3 class="mb-0">Danh mục loại phòng</h3><p class="page-subtitle">Thiết lập giá niêm yết, diện tích và mô tả cho từng loại phòng.</p></div>
    @if (laAdmin) { <a class="btn btn-primary" asp-action="Create">+ Thêm loại phòng</a> }
</div>
<table class="table table-hover bg-white">
    <thead><tr><th>Tên loại</th><th>Giá niêm yết</th><th>Diện tích</th><th>Mô tả</th>@if (laAdmin) { <th></th> }</tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.TenLoai</td><td>@Fmt.Vnd(x.GiaNiemYet)</td><td>@x.DienTich m²</td><td>@x.MoTa</td>
            @if (laAdmin)
            {
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Sửa</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDelete" data-action="@Url.Action("Delete", "LoaiPhong", new { id = x.Id })" data-name="@x.TenLoai">Xóa</button>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
