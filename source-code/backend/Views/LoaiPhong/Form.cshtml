@model LoaiPhong
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm loại phòng" : "Sửa loại phòng"; }
<h3 class="mb-3">@ViewData["Title"]</h3>
<form method="post" class="card card-body" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="TenLoai" class="form-label"></label><input asp-for="TenLoai" class="form-control" /><span asp-validation-for="TenLoai" class="text-danger"></span></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="GiaNiemYet" class="form-label"></label><input asp-for="GiaNiemYet" type="number" min="0" step="1000" class="form-control" /><span asp-validation-for="GiaNiemYet" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="DienTich" class="form-label"></label><input asp-for="DienTich" type="number" min="1" step="0.5" class="form-control" /><span asp-validation-for="DienTich" class="text-danger"></span></div>
    </div>
    <div class="mb-3"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" rows="3" class="form-control"></textarea></div>
    <div><button class="btn btn-primary" type="submit">Lưu</button> <a class="btn btn-secondary" asp-action="Index">Hủy</a></div>
</form>
