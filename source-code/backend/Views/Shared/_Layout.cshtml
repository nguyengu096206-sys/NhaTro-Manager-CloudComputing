@{
    var dangNhap = User.Identity != null && User.Identity.IsAuthenticated;
    var laAdmin = User.IsInRole("Administrator");
    string Active(string c) => (ViewContext.RouteData.Values["controller"] as string) == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title>@ViewData["Title"] - NhaTro Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/theme-polish.css" asp-append-version="true" />
</head>
<body>
<a class="visually-hidden-focusable" href="#mainContent">Bỏ qua điều hướng</a>
@if (dangNhap)
{
    <header class="topbar">
        <button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false" id="menuToggle">☰</button>
        <a class="brand" href="/"><span class="brand-mark">N</span><span><strong>NhaTro</strong><small>PROPERTY MANAGEMENT</small></span></a>
        <div class="topbar-right">
            <a class="api-link" href="/swagger" target="_blank" rel="noopener">API <span aria-hidden="true">↗</span></a>
            <div class="user-chip"><span class="user-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper())</span><span class="user-meta"><strong>@User.Identity?.Name</strong><small>@(laAdmin ? "Quản trị viên" : "Nhân viên")</small></span></div>
            <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                <button class="logout-btn" type="submit" title="Đăng xuất" aria-label="Đăng xuất">↪</button>
            </form>
        </div>
    </header>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="nav-caption">KHÔNG GIAN LÀM VIỆC</div>
            <a class="side-link @Active("Home")" href="/"><span class="nav-icon">⌂</span> Tổng quan</a>
            <div class="nav-caption nav-caption-spaced">QUẢN LÝ</div>
            <a class="side-link @Active("Phong")" href="/Phong"><span class="nav-icon">▦</span> Phòng trọ</a>
            <a class="side-link @Active("LoaiPhong")" href="/LoaiPhong"><span class="nav-icon">▤</span> Loại phòng</a>
            <a class="side-link @Active("NguoiThue")" href="/NguoiThue"><span class="nav-icon">♙</span> Người thuê</a>
            <a class="side-link @Active("HopDong")" href="/HopDong"><span class="nav-icon">▧</span> Hợp đồng</a>
            <a class="side-link @Active("HoaDon")" href="/HoaDon"><span class="nav-icon">₫</span> Hóa đơn</a>
            @if (laAdmin)
            {
                <div class="nav-caption nav-caption-spaced">HỆ THỐNG</div>
                <a class="side-link @Active("TaiKhoan")" href="/TaiKhoan"><span class="nav-icon">⚙</span> Tài khoản</a>
            }
            <div class="sidebar-bottom"><span class="status-dot"></span><span>Hệ thống đang hoạt động</span><small>Cloud-ready workspace</small></div>
        </aside>
        <main class="main-content" id="mainContent" tabindex="-1">
            <div class="page-topline"><span>TRUNG TÂM ĐIỀU HÀNH NHÀ TRỌ</span><span>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span></div>
            @if (TempData["ok"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show auto-close" role="alert">@TempData["ok"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div>
            }
            @if (TempData["err"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["err"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div>
            }
            @RenderBody()
            <footer class="app-footer">Đồ án Điện toán đám mây <span>·</span> Đề tài DA05 <span>·</span> Nhóm 5</footer>
        </main>
    </div>
}
else
{
    <main class="auth-shell">@RenderBody()</main>
}
@if (dangNhap)
{
    <div class="modal fade" id="confirmDelete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" class="modal-content"><div class="modal-header"><h5 class="modal-title">Xác nhận xóa</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body">Bạn có chắc muốn xóa <strong class="ten"></strong>? Thao tác này không thể hoàn tác.</div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-danger">Xóa</button></div></form>
    </div>
    </div>
}
<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
<script>
(function(){var b=document.getElementById("menuToggle"),s=document.querySelector(".sidebar");if(!b||!s)return;b.addEventListener("click",function(){var o=s.classList.toggle("open");b.setAttribute("aria-expanded",o?"true":"false");b.textContent=o?"×":"☰";});document.addEventListener("click",function(e){if(window.innerWidth<=700&&s.classList.contains("open")&&!s.contains(e.target)&&!b.contains(e.target)){s.classList.remove("open");b.setAttribute("aria-expanded","false");b.textContent="☰";}});})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
