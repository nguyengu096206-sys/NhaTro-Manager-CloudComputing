@{ ViewData["Title"] = "Đăng nhập"; }
<div class="login-layout">
    <section class="login-intro"><div class="login-brand"><span class="brand-mark">N</span><span><strong>NhaTro Manager</strong><small>PROPERTY MANAGEMENT</small></span></div><div class="login-copy"><span class="login-kicker">VẬN HÀNH NHÀ TRỌ DỄ DÀNG</span><h1>Mọi hoạt động<br/>trong tầm kiểm soát.</h1><p>Quản lý phòng, người thuê, hợp đồng và hóa đơn trên cùng một nền tảng.</p><div class="login-features"><span>✓ Theo dõi phòng trống và đang thuê</span><span>✓ Quản lý hợp đồng và kỳ thanh toán</span><span>✓ Lưu trữ hồ sơ tập trung</span></div></div><div class="login-footnote">NhaTro Manager · Cloud-ready workspace</div></section>
    <section class="login-form-wrap"><div class="login-form-card"><div class="login-mobile-brand">NhaTro Manager</div><div class="eyebrow">CHÀO MỪNG QUAY TRỞ LẠI</div><h2>Đăng nhập hệ thống</h2><p class="page-subtitle mb-4">Nhập thông tin tài khoản để tiếp tục.</p>
        @if (ViewBag.Loi != null) { <div class="alert alert-danger">@ViewBag.Loi</div> }
        <form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /><div class="mb-3"><label class="form-label" for="tenDangNhap">Tên đăng nhập</label><input class="form-control" id="tenDangNhap" name="tenDangNhap" placeholder="Nhập tên đăng nhập" autocomplete="username" required autofocus /></div><div class="mb-4"><label class="form-label" for="matKhau">Mật khẩu</label><input class="form-control" id="matKhau" name="matKhau" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required /></div><button class="btn btn-primary w-100 login-submit" type="submit">Đăng nhập <span>→</span></button></form><div class="login-security">Thông tin đăng nhập được bảo vệ bởi hệ thống xác thực.</div></div></section>
</div>
