@model PhongDetailsVm
@{ ViewData["Title"] = "Phòng " + Model.Phong.MaPhong; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Phòng @Model.Phong.MaPhong &ndash; @Model.Phong.TenPhong</h3>
    <div>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Phong.Id">Sửa</a>
        <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card h-100"><div class="card-header fw-semibold">Thông tin phòng</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span>Tầng</span><strong>@Model.Phong.Tang</strong></li>
                <li class="list-group-item d-flex justify-content-between"><span>Loại phòng</span><strong>@Model.Phong.LoaiPhong?.TenLoai</strong></li>
                <li class="list-group-item d-flex justify-content-between"><span>Diện tích</span><strong>@Model.Phong.LoaiPhong?.DienTich m²</strong></li>
                <li class="list-group-item d-flex justify-content-between"><span>Giá niêm yết</span><strong>@Fmt.Vnd(Model.Phong.LoaiPhong?.GiaNiemYet ?? 0)</strong></li>
                <li class="list-group-item d-flex justify-content-between"><span>Trạng thái</span><strong>@Model.Phong.TrangThai</strong></li>
                <li class="list-group-item"><span class="text-muted">Ghi chú:</span> @Model.Phong.GhiChu</li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100"><div class="card-header fw-semibold">Hợp đồng hiện tại</div>
            <div class="card-body">
                @if (Model.HopDongHienTai != null)
                {
                    <p class="mb-1">Số hợp đồng: <a asp-controller="HopDong" asp-action="Details" asp-route-id="@Model.HopDongHienTai.Id">@Model.HopDongHienTai.SoHopDong</a></p>
                    <p class="mb-1">Người thuê: <strong>@Model.HopDongHienTai.NguoiThue.HoTen</strong> (@Model.HopDongHienTai.NguoiThue.SoDienThoai)</p>
                    <p class="mb-1">Thời hạn: @Fmt.Ngay(Model.HopDongHienTai.NgayBatDau) &ndash; @Fmt.Ngay(Model.HopDongHienTai.NgayKetThuc)</p>
                    <p class="mb-0">Giá thuê: @Fmt.Vnd(Model.HopDongHienTai.GiaThue)/tháng</p>
                }
                else
                {
                    <p class="text-muted">Phòng chưa có hợp đồng hiệu lực.</p>
                    @if (Model.Phong.TrangThai == "Trống")
                    {
                        <a class="btn btn-success" asp-controller="HopDong" asp-action="Create" asp-route-phongId="@Model.Phong.Id">Lập hợp đồng</a>
                    }
                }
            </div>
        </div>
    </div>
</div>
<partial name="_Tep" model="Model.Tep" />
