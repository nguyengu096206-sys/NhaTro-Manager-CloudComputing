@model List<Phong>
@{
    ViewData["Title"] = "Phòng"; var laAdmin = User.IsInRole("Administrator");
    string BadgeClass(string t) => t == "Đang thuê" ? "bg-success" : t == "Bảo trì" ? "bg-warning text-dark" : "bg-primary";
}
<div class="d-flex justify-content-between align-items-center mb-3 page-heading"><div><div class="eyebrow">DANH MỤC TÀI SẢN</div><h3 class="mb-0">Quản lý phòng trọ</h3><p class="page-subtitle">Theo dõi tình trạng phòng, loại phòng và thông tin từng phòng.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Thêm phòng</a>
</div>
<form method="get" class="row g-2 mb-3 filter-panel">
    <div class="col-md-5"><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo mã hoặc tên phòng..." /></div>
    <div class="col-md-3">
        <select name="trangThai" class="form-select">
            <option value="">Tất cả trạng thái</option>
            @foreach (var t in TrangThaiPhong.All) { <option value="@t" selected="@((string)ViewBag.TrangThai == t)">@t</option> }
        </select>
    </div>
    <div class="col-md-4"><button class="btn btn-outline-primary" type="submit">Tìm</button> <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div>
</form>
<table class="table table-hover bg-white align-middle">
    <thead><tr><th>Mã phòng</th><th>Tên phòng</th><th>Tầng</th><th>Loại phòng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@p.Id">@p.MaPhong</a></td>
            <td>@p.TenPhong</td><td>@p.Tang</td><td>@p.LoaiPhong?.TenLoai</td>
            <td><span class="badge @BadgeClass(p.TrangThai)">@p.TrangThai</span></td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">Xem</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Sửa</a>
                @if (laAdmin)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDelete" data-action="@Url.Action("Delete", "Phong", new { id = p.Id })" data-name="phòng @p.MaPhong">Xóa</button>
                }
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted">Không có phòng nào.</td></tr> }
    </tbody>
</table>
